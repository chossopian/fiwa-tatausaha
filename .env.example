# ==========================================
# SUPABASE CONFIGURATION
# ==========================================

# Public/Anon key - AMAN diekspos ke browser (client-side)
# Dipakai untuk fetch data publik (homepage, gallery, staff directory, dll)
# RLS (Row Level Security) di Supabase akan membatasi akses data lewat key ini
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role key - RAHASIA, JANGAN PERNAH diekspos ke browser
# Hanya dipakai di server-side (halaman /admin/* yang prerender=false)
# Key ini bypass semua RLS, jadi punya akses penuh ke semua data
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# ADMIN ACCESS CONTROL
# ==========================================

# Login admin memakai Google OAuth (via Supabase Auth).
# Karena siapa saja bisa punya akun Google, wajib ada whitelist email
# supaya hanya staf tata usaha tertentu yang bisa akses dashboard.
#
# Format: daftar email dipisah koma, TANPA spasi setelah koma.
# Contoh: ADMIN_ALLOWED_EMAILS=tu1@gmail.com,tu2@gmail.com,kepsek@gmail.com
ADMIN_ALLOWED_EMAILS=admin1@gmail.com,admin2@gmail.com
